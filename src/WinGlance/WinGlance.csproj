<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>icon.ico</ApplicationIcon>

    <!-- Versioning & Metadata -->
    <Version>1.2.1</Version>
    <AssemblyVersion>1.2.1.0</AssemblyVersion>
    <FileVersion>1.2.1.0</FileVersion>
    <Product>WinGlance</Product>
    <Company>WinGlance Contributors</Company>
    <Authors>mortalezz, garrul4ik</Authors>
    <Description>Ultra-fast, zero-latency GPU &amp; AI RAW photo viewer and pro culling tool for Windows 11 (Direct3D 11 / Direct2D 1.3 HDR / DirectML / LibRaw). Standalone Windows port of Glance for macOS by mortalezz (https://github.com/mortalezz/glance).</Description>
    <Copyright>Copyright © 2026 mortalezz (Glance), WinGlance Contributors</Copyright>

    <!-- NativeAOT Optimization Settings -->
    <IsAotCompatible>true</IsAotCompatible>
    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.6.2" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Sdcb.LibRaw" Version="0.21.1.6" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\libraw_win64.br" LogicalName="WinGlance.libraw_win64.br" />
    <EmbeddedResource Include="Resources\yunet.onnx.br" LogicalName="WinGlance.yunet.onnx.br" />
  </ItemGroup>

</Project>
