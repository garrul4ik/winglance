<Window x:Class="WinGlance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:WinGlance.UI"
        mc:Ignorable="d"
        Title="WinGlance"
        Icon="icon.ico"
        Height="800" Width="1200"
        WindowStyle="None"
        WindowState="Maximized"
        Background="#080808"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        KeyDown="OnKeyDown"
        MouseMove="OnWindowMouseMove"
        MouseDown="OnWindowMouseDown"
        Drop="OnWindowDrop"
        DragOver="OnWindowDragOver">

    <Window.Resources>
        <Style x:Key="HudCard" TargetType="Border">
            <Setter Property="Background" Value="#D9161616"/>
            <Setter Property="BorderBrush" Value="#2BFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillBadge" TargetType="Border">
            <Setter Property="Background" Value="#2AFFFFFF"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,3"/>
        </Style>

        <Storyboard x:Key="PulseClipping">
            <DoubleAnimation Storyboard.TargetName="ClippingOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0.4" To="1.0" Duration="0:0:0.7"
                             AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- 1. MAIN IMAGE CANVAS -->
        <Grid x:Name="ViewportGrid" Background="#050505"
              MouseDown="OnViewportMouseDown"
              MouseMove="OnViewportMouseMove"
              MouseUp="OnViewportMouseUp"
              MouseWheel="OnViewportMouseWheel">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" x:Name="ColLeft"/>
                <ColumnDefinition Width="Auto" x:Name="ColSplitter"/>
                <ColumnDefinition Width="0" x:Name="ColRight"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT / MAIN IMAGE -->
            <Grid Grid.Column="0" ClipToBounds="True">
                <Image x:Name="MainImage"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="MainScaleTransform" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="MainTranslateTransform" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>

                <!-- Exposure Clipping Overlay -->
                <Image x:Name="ClippingOverlay"
                       Visibility="Collapsed"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.85"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Grid>

            <!-- SPLIT DIVIDER -->
            <Rectangle Grid.Column="1" Width="2" Fill="#33FFFFFF" x:Name="SplitDivider" Visibility="Collapsed"/>

            <!-- RIGHT / COMPARE IMAGE (2-Up burst compare) -->
            <Grid Grid.Column="2" ClipToBounds="True" x:Name="RightGrid" Visibility="Collapsed">
                <Image x:Name="RightImage"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="RightScaleTransform" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="RightTranslateTransform" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Grid>
        </Grid>

        <!-- 2. TOP HEADER HUD -->
        <Border Style="{StaticResource HudCard}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,18,0,0"
                Padding="12,7"
                x:Name="TopHud">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Index -->
                <TextBlock x:Name="TxtIndex" Text="0 / 0" Foreground="#F0F0F0" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>

                <!-- RAW Badge -->
                <Border Style="{StaticResource PillBadge}" Background="#E65100" Margin="10,0,0,0" x:Name="BadgeRaw" Visibility="Collapsed">
                    <TextBlock Text="RAW" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                </Border>

                <!-- Filter Badge -->
                <Border Style="{StaticResource PillBadge}" Background="#00838F" Margin="8,0,0,0" x:Name="BadgeFilter" Visibility="Collapsed">
                    <TextBlock x:Name="TxtFilter" Text="All" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/>
                </Border>

                <!-- 100% Zoom Badge -->
                <Border Style="{StaticResource PillBadge}" Background="#2E7D32" Margin="8,0,0,0" x:Name="BadgeZoom" Visibility="Collapsed">
                    <TextBlock Text="100%" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                </Border>

                <!-- Auto-Advance Badge -->
                <Border Style="{StaticResource PillBadge}" Background="#F57F17" Margin="8,0,0,0" x:Name="BadgeAuto" Visibility="Collapsed">
                    <TextBlock Text="AUTO" Foreground="#000000" FontWeight="Bold" FontSize="11"/>
                </Border>

                <!-- Slideshow Badge -->
                <Border Style="{StaticResource PillBadge}" Background="#6A1B9A" Margin="8,0,0,0" x:Name="BadgeSlideshow" Visibility="Collapsed">
                    <TextBlock x:Name="TxtSlideshow" Text="SLIDESHOW 3.0s" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/>
                </Border>

                <!-- Export Progress -->
                <Border Style="{StaticResource PillBadge}" Background="#1565C0" Margin="8,0,0,0" x:Name="BadgeExport" Visibility="Collapsed">
                    <TextBlock x:Name="TxtExport" Text="Exporting..." Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- 3. CENTER ACTION FEEDBACK BADGE (Rating, Pick, Color) -->
        <Border Style="{StaticResource HudCard}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="28,16"
                CornerRadius="16"
                x:Name="CenterFeedbackHud"
                Opacity="0"
                IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="TxtFeedbackRating" Text="★ ★ ★ ★ ★" Foreground="#FFD700" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtFeedbackStatus" Text="PICK" Foreground="#4CAF50" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- 4. BOTTOM INFO HUD -->
        <Border Style="{StaticResource HudCard}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,22"
                Padding="20,10"
                x:Name="BottomHud">
            <StackPanel HorizontalAlignment="Center">
                <!-- Line 1: Filename + Tech stats -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtFilename" Text="No image loaded" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDimensions" Text="" Foreground="#B0B0B0" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtFileSize" Text="" Foreground="#808080" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Line 2: EXIF summary -->
                <TextBlock x:Name="TxtExif" Text="" Foreground="#9E9E9E" FontSize="12" Margin="0,3,0,0" HorizontalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- 5. HISTOGRAM HUD (H) -->
        <Border Style="{StaticResource HudCard}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                Padding="12,10"
                Width="280" Height="170"
                x:Name="HistogramHud"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="HISTOGRAM" Foreground="#88FFFFFF" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                <ui:HistogramControl x:Name="HistogramView" Grid.Row="1"/>
            </Grid>
        </Border>

        <!-- 6. SHORTCUTS CHEATSHEET OVERLAY (?) -->
        <Grid x:Name="CheatsheetOverlay" Background="#B3000000" Visibility="Collapsed" MouseDown="OnCheatsheetClose">
            <Border Style="{StaticResource HudCard}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="680"
                    Padding="28,24"
                    CornerRadius="16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,18">
                        <TextBlock Text="⚡ WinGlance Keyboard Shortcuts" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left"/>
                        <TextBlock Text="[Esc / ? to close]" Foreground="#888888" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <!-- Left Column: Culling & Review -->
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="🏷️ CULLING &amp; RATINGS" Foreground="#FFD700" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                            <TextBlock Text="P : Pick (Green badge)" Foreground="#E0E0E0" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="X : Reject (Red badge)" Foreground="#E0E0E0" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="U : Unflag" Foreground="#E0E0E0" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="1 – 5 : Star Rating (★)" Foreground="#E0E0E0" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="0 : Clear Rating" Foreground="#E0E0E0" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="6 – 9 : Color Labels (Red/Yel/Grn/Blu)" Foreground="#E0E0E0" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="C : Toggle Auto-Advance" Foreground="#E0E0E0" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="\ : Cycle Culling Filters" Foreground="#E0E0E0" FontSize="12" Margin="0,2"/>
                        </StackPanel>

                        <!-- Right Column: Navigation & Tools -->
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock Text="🔍 REVIEW &amp; TOOLS" Foreground="#4FC3F7" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                            <TextBlock Text="Z / Click : 100% 1:1 Pixel Peep" Foreground="#E0E0E0" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="S / Tab : 2-Up Split Burst Compare" Foreground="#E0E0E0" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="H : Toggle RGB Histogram" Foreground="#E0E0E0" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="O : Exposure Clipping Warnings" Foreground="#E0E0E0" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="I : Toggle Detailed EXIF Info" Foreground="#E0E0E0" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="R / ] : Lossless Rotate CW ↷" Foreground="#E0E0E0" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="L / [ : Lossless Rotate CCW ↶" Foreground="#E0E0E0" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="E : Export Picks to ./Picks" Foreground="#E0E0E0" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="Del : Move file to Recycle Bin" Foreground="#E0E0E0" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="Return : Start / Stop Slideshow" Foreground="#E0E0E0" FontSize="12" Margin="0,2"/>
                            <TextBlock Text="F : Toggle Fullscreen" Foreground="#E0E0E0" FontSize="12" Margin="0,2"/>
                        </StackPanel>
                    </UniformGrid>

                    <Border BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,10,0,0">
                        <TextBlock Text="WinGlance 1.0.0 · Standalone Windows 11 port of Glance (macOS) by @mortalezz (github.com/mortalezz/glance)"
                                   Foreground="#777777" FontSize="11" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
